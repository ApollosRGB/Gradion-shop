{
  "name": "treat-stand-order-app",
  "productName": "Gradion Shop",
  "version": "1.17.0",
  "description": "Gradion Shop — Shopee-style order app dispatching to SYNAOS (AGV transport jobs) or MPDV (production orders).",
  "main": "main.js",
  "author": "ApollosRGB",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "aedes": "^0.51.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gradion.shop",
    "productName": "Gradion Shop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "GradionShop-Setup-${version}.${ext}"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "universal"
        ]
      },
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": null
    },
    "dmg": {
      "artifactName": "GradionShop-${version}.${ext}"
    }
  },
  "dependencies": {
    "mqtt": "^5.15.2"
  }
}
